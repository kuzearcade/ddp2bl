diff --git a/src/mame/igs/ddp2_capture.h b/src/mame/igs/ddp2_capture.h
new file mode 100644
index 00000000000..daa42439c68
--- /dev/null
+++ b/src/mame/igs/ddp2_capture.h
@@ -0,0 +1,174 @@
+// license:BSD-3-Clause
+// copyright-holders:ddp2bl project
+/***********************************************************************
+ Opt-in analysis instrumentation for the IGS027A type 2 protection
+ (used by the ddp2bl ASIC-removal project). Inactive unless the
+ DDP2_CAPTURE environment variable names an output directory.
+
+ capture.bin is a stream of records:
+   u8  type   (1 = 68k latch write, 2 = ARM latch write, 3 = 68k latch read)
+   u32 seq, u32 frame, u64 68k cycles, u64 ARM cycles, u32 value, u32 aux
+   then, for types 1 and 2, sparse diffs of each tracked region against the
+   previous record: repeated (u32 offset, u32 length, bytes...), ended by length 0.
+ Record types 4 and 5 carry no diffs:
+   4 = ARM write to the EST job busy flag (0x18000080): value = data, aux = mem_mask
+   5 = 68k idle period (game waiting for vblank): frame = frame at entry, 68k cycles field =
+       entry cycle, ARM cycles field = cycle when the next busy period was detected,
+       value = idle-loop reads, aux = cycles from entry to the last idle read
+ Regions: 0 = shared RAM (64K, ARM view, little endian dwords),
+          1 = ARM RAM 0x18000000 (64K), 2 = ARM IRAM 0x10000000 (1K).
+
+ coverage.bin (written at exit): for each command id seen
+   u32 cmd, u32 nbytes, bitmap of executed halfwords in 0x00000000-0x00003fff,
+   then 0x08000000-0x0801ffff (bit set = instruction started there),
+   then u32 thumb-bitmap length + bitmap (bit set = executed in Thumb state),
+   then read bitmaps (one bit per byte) for regions 0..2.
+***********************************************************************/
+#ifndef MAME_IGS_DDP2_CAPTURE_H
+#define MAME_IGS_DDP2_CAPTURE_H
+
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+class ddp2_capture
+{
+public:
+	static constexpr u32 INT_SIZE = 0x4000;
+	static constexpr u32 EXT_BASE = 0x08000000;
+	static constexpr u32 EXT_SIZE = 0x20000;
+
+	struct region { const u8 *mem; u32 size; std::vector<u8> shadow; };
+	struct percmd
+	{
+		std::vector<u8> exec, thumb;            // over (INT_SIZE + EXT_SIZE) / 2 halfwords
+		std::vector<u8> reads[3];
+		u64 insns = 0, calls = 0;
+	};
+
+	ddp2_capture(const std::string &dir) : m_dir(dir)
+	{
+		m_out = std::fopen((dir + "/capture.bin").c_str(), "wb");
+	}
+
+	~ddp2_capture()
+	{
+		if (m_out)
+			std::fclose(m_out);
+		write_coverage();
+	}
+
+	// 68k main RAM access footprint (one bit per byte), written to mainram_rw.bin at exit
+	void main_access(bool write, u32 off, u16 mask)
+	{
+		std::vector<u8> &b = write ? m_main_w : m_main_r;
+		off &= 0x1fffe; // main RAM is mirrored; taps may report mirrored addresses
+		if (mask & 0xff00) b[off >> 3] |= 1 << (off & 7);
+		if (mask & 0x00ff) b[(off + 1) >> 3] |= 1 << ((off + 1) & 7);
+	}
+
+	void add_region(const void *mem, u32 size) { m_regions.push_back(region{ static_cast<const u8 *>(mem), size, std::vector<u8>(size, 0) }); }
+
+	void set_cmd(u32 cmd) { m_cur = &get(cmd); m_cur->calls++; }
+
+	void insn(u32 pc, bool thumb)
+	{
+		percmd &c = *m_cur;
+		u32 idx;
+		if (pc < INT_SIZE) idx = pc >> 1;
+		else if (pc - EXT_BASE < EXT_SIZE) idx = (INT_SIZE + (pc - EXT_BASE)) >> 1;
+		else return;
+		c.exec[idx >> 3] |= 1 << (idx & 7);
+		if (thumb) c.thumb[idx >> 3] |= 1 << (idx & 7);
+		c.insns++;
+	}
+
+	void read(int reg, u32 off, u32 mask)
+	{
+		std::vector<u8> &b = m_cur->reads[reg];
+		const u32 size = u32(b.size()) * 8;
+		off &= ~3U;
+		for (int i = 0; i < 4; i++)
+			if ((mask & (0xffU << (i * 8))) && off + i < size)
+				b[(off + i) >> 3] |= 1 << ((off + i) & 7);
+	}
+
+	void record(u8 type, u32 frame, u64 cyc68k, u64 cycarm, u32 value, u32 aux, bool diffs)
+	{
+		if (!m_out)
+			return;
+		put(&type, 1); put32(m_seq++); put32(frame); put64(cyc68k); put64(cycarm); put32(value); put32(aux);
+		if (!diffs)
+			return;
+		for (region &r : m_regions)
+		{
+			u32 i = 0;
+			while (i < r.size)
+			{
+				if (r.mem[i] == r.shadow[i]) { i++; continue; }
+				u32 start = i;
+				// merge runs separated by fewer than 8 equal bytes
+				u32 same = 0;
+				while (i < r.size && same < 8) { same = (r.mem[i] == r.shadow[i]) ? same + 1 : 0; i++; }
+				u32 len = i - start - same;
+				put32(start); put32(len); put(r.mem + start, len);
+				std::memcpy(&r.shadow[start], r.mem + start, len);
+			}
+			put32(0); put32(0);
+		}
+	}
+
+private:
+	percmd &get(u32 cmd)
+	{
+		auto it = m_cmds.find(cmd);
+		if (it != m_cmds.end())
+			return it->second;
+		percmd &c = m_cmds[cmd];
+		const u32 n = (INT_SIZE + EXT_SIZE) / 2 / 8;
+		c.exec.assign(n, 0); c.thumb.assign(n, 0);
+		for (int i = 0; i < 3; i++) c.reads[i].assign(i == 2 ? 0x400 / 8 : 0x10000 / 8, 0);
+		return c;
+	}
+
+	void write_coverage()
+	{
+		if (FILE *m = std::fopen((m_dir + "/mainram_rw.bin").c_str(), "wb"))
+		{
+			std::fwrite(m_main_r.data(), 1, m_main_r.size(), m);
+			std::fwrite(m_main_w.data(), 1, m_main_w.size(), m);
+			std::fclose(m);
+		}
+		FILE *f = std::fopen((m_dir + "/coverage.bin").c_str(), "wb");
+		if (!f)
+			return;
+		for (auto &[cmd, c] : m_cmds)
+		{
+			u32 hdr[4] = { cmd, u32(c.exec.size()), u32(c.calls), u32(c.insns) };
+			std::fwrite(hdr, 4, 4, f);
+			std::fwrite(c.exec.data(), 1, c.exec.size(), f);
+			std::fwrite(c.thumb.data(), 1, c.thumb.size(), f);
+			for (auto &r : c.reads) { u32 n = r.size(); std::fwrite(&n, 4, 1, f); std::fwrite(r.data(), 1, n, f); }
+		}
+		std::fclose(f);
+	}
+
+	void put(const void *p, size_t n) { std::fwrite(p, 1, n, m_out); }
+	void put32(u32 v) { put(&v, 4); }
+	void put64(u64 v) { put(&v, 8); }
+
+	std::string m_dir;
+	FILE *m_out = nullptr;
+	u32 m_seq = 0;
+	std::vector<region> m_regions;
+	std::map<u32, percmd> m_cmds;
+	std::vector<u8> m_main_r = std::vector<u8>(0x20000 / 8, 0), m_main_w = std::vector<u8>(0x20000 / 8, 0);
+	percmd *m_cur = &get(0xffffffff); // boot / idle code before the first command
+};
+
+#endif // MAME_IGS_DDP2_CAPTURE_H
