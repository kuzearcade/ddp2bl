+void pgm_arm_type2_state::machine_start()
+{
+	pgm_state::machine_start();
+
+	const char *dir = std::getenv("DDP2_CAPTURE");
+	if (!dir)
+		return;
+
+	m_capscreen = subdevice<screen_device>("screen");
+	m_cap = std::make_unique<ddp2_capture>(dir);
+	m_cap->add_region(m_arm7_shareram.target(), 0x10000);
+	m_cap->add_region(m_arm_ram.target(), 0x10000);
+	m_cap->add_region(memshare("iram")->ptr(), 0x400);
+
+	address_space &sp = m_prot->space(AS_PROGRAM);
+	const u32 bases[3] = { 0x48000000, 0x18000000, 0x10000000 };
+	const u32 sizes[3] = { 0x10000, 0x10000, 0x400 };
+	for (int r = 0; r < 3; r++)
+	{
+		const u32 base = bases[r];
+		m_captap[r] = sp.install_read_tap(base, base + sizes[r] - 1, "ddp2cap",
+				[this, r, base] (offs_t offset, u32 &data, u32 mem_mask) { m_cap->read(r, offset - base, mem_mask); },
+				nullptr);
+	}
