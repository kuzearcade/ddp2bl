+void pgm_state::init_ddp2bl()
+{
+	pgm_basic_init();
+
+	// ddp2bl verification probe (opt-in): the 68000 replacement writes two longs at
+	// DDP2BL_PROBE_ADDR around its idle-time job; log the CPU cycle count at each write
+	// together with the value written (its own cycle accounting), to DDP2BL_PROBE.
+	if (const char *probe = std::getenv("DDP2BL_PROBE"))
+	{
+		const offs_t addr = std::strtoul(std::getenv("DDP2BL_PROBE_ADDR"), nullptr, 16);
+		static FILE *f = std::fopen(probe, "w");
+		m_maincpu->space(AS_PROGRAM).install_write_tap(addr, addr + 15, "ddp2bl_probe",
+				[this, addr] (offs_t offset, u16 &data, u16 mem_mask)
+				{
+					if (f) { std::fprintf(f, "%u %llu %04x\n", unsigned(offset - addr), (unsigned long long)m_maincpu->total_cycles(), data); std::fflush(f); }
+				});
+	}
+
+	// no IGS027A on this cartridge: any access to the old ARM shared RAM / latch window is a conversion bug
+	m_maincpu->space(AS_PROGRAM).install_readwrite_handler(0xd00000, 0xd1ffff,
+			read16s_delegate(*this, [this] (offs_t offset, u16 mem_mask) -> u16 {
+				if (!machine().side_effects_disabled())
+				{
+					logerror("ddp2bl: stray read %06x (%04x) at %06x\n", 0xd00000 + offset * 2, mem_mask, m_maincpu->pc());
+					if (std::getenv("DDP2BL_TRAP")) fatalerror("ddp2bl: stray read %06x at %06x\n", 0xd00000 + offset * 2, m_maincpu->pc());
+				}
+				return 0xffff;
+			}, "ddp2bl_trap_r"),
+			write16s_delegate(*this, [this] (offs_t offset, u16 data, u16 mem_mask) {
+				logerror("ddp2bl: stray write %06x = %04x (%04x) at %06x\n", 0xd00000 + offset * 2, data, mem_mask, m_maincpu->pc());
+				if (std::getenv("DDP2BL_TRAP")) fatalerror("ddp2bl: stray write %06x at %06x\n", 0xd00000 + offset * 2, m_maincpu->pc());
+			}, "ddp2bl_trap_w"));
+}
